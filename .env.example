# --- Banco de dados ---
# Padrão: SQLite local (arquivo dev.db na raiz do projeto).
# Para trocar por Postgres/MySQL depois, veja prisma/schema.prisma e README.md.
DATABASE_URL="file:./dev.db"

# --- E-mail de boas-vindas (enviado via Resend quando alguém se cadastra) ---
# 1. Crie uma conta em https://resend.com (tem plano gratuito)
# 2. Gere uma API key no painel e cole abaixo
# 3. Verifique um domínio no Resend e troque EMAIL_FROM por um endereço
#    desse domínio (sem isso, o Resend só permite enviar para o seu
#    próprio e-mail de cadastro, útil pra testar mas não pra produção)
# Sem essas duas variáveis preenchidas, o cadastro continua funcionando
# normalmente — só o e-mail de boas-vindas não é enviado (fica só um aviso
# no log do servidor).
RESEND_API_KEY=""
EMAIL_FROM="contato@seudominio.com.br"

# URL pública do site, usada no link do e-mail de boas-vindas. Troque pelo
# domínio real quando o site estiver publicado.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
