generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// SQLite não suporta enums nem arrays nativamente, então campos que seriam
// enum/array (faixaEtaria, materia, categoria, corpo, aplicacao) são
// gravados como String simples ou JSON-encoded String. A validação dos
// valores permitidos acontece em TypeScript (ver lib/types.ts) e a
// serialização/deserialização acontece em lib/db.ts.

model Devocional {
  id              String   @id @default(cuid())
  slug            String   @unique
  titulo          String
  data            DateTime
  versiculo       String
  referencia      String
  corpo           String // JSON: string[]
  aplicacao       String // JSON: string[]
  oracao          String
  faixaEtaria     String // JSON: FaixaEtaria[]
  tempoLeituraMin Int
  audioUrl        String?
  criadoEm        DateTime @default(now())
}

model EstudoTeologico {
  id              String   @id @default(cuid())
  slug            String   @unique
  titulo          String
  materia         String // MateriaTeologica
  resumo          String
  corpo           String // JSON: string[]
  data            DateTime
  tempoLeituraMin Int
  criadoEm        DateTime @default(now())
}

model ArtigoVidaSociedade {
  id              String   @id @default(cuid())
  slug            String   @unique
  titulo          String
  categoria       String // CategoriaVidaSociedade
  resumo          String
  corpo           String // JSON: string[]
  data            DateTime
  tempoLeituraMin Int
  criadoEm        DateTime @default(now())
}

model Subscriber {
  id          String   @id @default(cuid())
  nome        String
  email       String   @unique
  faixaEtaria String // FaixaEtaria
  denominacao String?
  trilha      String // "devocionais" | "estudos" | "ambos"
  criadoEm    DateTime @default(now())
}
